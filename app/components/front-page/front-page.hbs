  <section class="membership-section">
    <img
      src="/images/frontpage/cozy-coffee.jpg"
      alt="cozy-coffee"
      class="cozy-coffee"
    />
    <div class="points-container" {{intersection-observer}}>
      <h3 class="points-container-h3">Subscription has its perks!</h3>
      <ul>
        <li class="points">Free shipping on all subscriptions.</li>
        <li class="points">Exclusive member pricing on all single coffees.</li>
        <li class="points">Earn free coffee with 5% back in credits on every
          purchase.</li>
        <li class="points">VIP treatment with members-only promotions, early
          access, and surprise gifts!</li>

      </ul>
      <LinkTo @route="coffees" class="get-started-btn">Get Started!</LinkTo>
    </div>

  </section>
  <section class="images-with-text-section" {{intersection-observer}}>
    <h2 class="images-with-text-section-header">News</h2>
    <div class="images-with-text-content">
      <div class="image-news-card">
        <div class="image-text-img-wrapper">
          <img
            src="/images/frontpage/front-page-coffee-03.png"
            class="image-text-img"
            alt="Fresh Roast Coffee"
          />
        </div>
        <p class="image-text-meta">New Arrival • Dark Roast</p>
        <h3 class="image-text-header">French Roast Coffee</h3>
        <div class="image-text-action">
          <LinkTo class="image-text-button" @route="coffees">
            Explore ⭢
          </LinkTo>
        </div>
      </div>
      <div class="image-news-card">
        <div class="image-text-img-wrapper">
          <img
            src="/images/frontpage/front-page-coffee-03.png"
            class="image-text-img"
            alt="Fresh Roast Coffee"
          />
        </div>
        <p class="image-text-meta">Limited Edition • Single Origin</p>
        <h3 class="image-text-header">Colombia Narino Roast</h3>
        <div class="image-text-action">
          <LinkTo class="image-text-button" @route="coffees">
            Explore ⭢
          </LinkTo>
        </div>
      </div>
      <div class="image-news-card">
        <div class="image-text-img-wrapper">
          <img
            src="/images/frontpage/front-page-coffee-03.png"
            class="image-text-img"
            alt="Fresh Roast Coffee"
          />
        </div>
        <p class="image-text-meta">Featured Flavor • Aromatic</p>
        <h3 class="image-text-header">Hazelnut Specialty</h3>
        <div class="image-text-action">
          <LinkTo class="image-text-button" @route="coffees">
            Explore ⭢
          </LinkTo>
        </div>
      </div>
    </div>
  </section>
  <section class="explore-coffee-section">
    <h3 class="explore-coffee-section-h3">EXPLORE THE WORLD OF COFFEE</h3>
    <div><b>up now or give a gift!</b>
      Coffee from around the world, delivered to your door.
    </div>
    <div class="explore-coffee-btns">
      <LinkTo @route="coffees" class="get-started-btn">Join now!</LinkTo>
      <LinkTo @route="coffees" class="get-started-btn">Give as a gift!</LinkTo>
    </div>
  </section>
</div>