<div
  class={{if
    this.open.isOpen
    "shopping-cart shopping-cart-open"
    "shopping-cart shopping-cart-closed"
  }}
  id="rightMenu"
>
  <button
    onclick={{this.toggleOpen}}
    class="close-shopping-cart"
    type="button"
  >&times;</button>

  <div class="shopping-cart-content">
    <div class="shopping-cart-header">
      <h2>Shopping Cart</h2>
      <small>x items</small>
    </div>

    <a href="#" class="">Link 1</a>
    <a href="#" class="">Link 2</a>
    <a href="#" class="">Link 3</a>
    <div class="summary">Summary</div>
  </div>
  {{#each this.shoppingCart.items as |item|}}
    <li>
      {{item.name}}
      {{item.ground}}
      {{item.quantity}}
      €{{item.price}}
      <button
        type="button"
        {{on "click" (fn this.removeItem item)}}
      >Remove</button>
    </li>
  {{/each}}
  <div>Total:{{this.shoppingCart.total}}</div>

</div>

<div
  class={{if
    this.open.isOpen
    "shopping-cart-overlay shopping-cart-overlay-open"
    "shopping-cart-overlay-closed"
  }}
  onclick={{this.toggleOpen}}
  style="cursor:pointer"
  id="shopping-cart-overlay"
></div>