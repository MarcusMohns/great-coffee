<div class="coffees">
  <div class="coffees-header">
    <div class="coffees-search-container">
      <Input
        @value={{this.query}}
        class="coffees-search-input"
        placeholder="Search for some Coffee!"
        autocomplete="off"
      />
    </div>
    <div class="coffees-breadcrumbs">
      <LinkTo @route="index" class="coffees-breadcrumb-link">Home</LinkTo>
      <span class="coffees-breadcrumb-separator">></span>
      <LinkTo @route="coffees" class="coffees-breadcrumb-link">Coffees</LinkTo>
    </div>
  </div>

  <div class="coffees-results-grid">
    <Coffees::Filter @coffees={{@coffees}} @query={{this.query}} as |results|>
      {{#each results as |coffee|}}
        <Coffee @coffee={{coffee}} />
      {{/each}}
    </Coffees::Filter>
  </div>
</div>