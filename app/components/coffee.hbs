<article class="coffee">
  <div class="coffee-image-container">
    <Coffee::Image src={{@coffee.image}} alt={{@coffee.name}} />
  </div>
  <div class="coffee-details">
    <h3 class="coffee-name">
      <LinkTo @route="coffee" @model={{@coffee.id}}>
        {{@coffee.name}}
      </LinkTo>
    </h3>
    <div class="coffee-meta">
      <p class="coffee-owner">
        <span>Origin:</span>
        Great Coffee Co.
      </p>
      <p class="coffee-type">
        <span>Type:</span>
        {{@coffee.type}}
      </p>
      <p class="coffee-bean">
        <span>Bean:</span>
        {{@coffee.bean}}
      </p>
      <span class="roast-badge {{@coffee.roastLevel}}">
        {{@coffee.roastLevel}}
        Roast
      </span>
    </div>
    <div class="coffee-description-drawer">
      <input
        type="checkbox"
        id="desc-toggle-{{@coffee.id}}"
        class="drawer-toggle"
      />
      <p class="coffee-description">
        {{@coffee.description}}
      </p>
      <label for="desc-toggle-{{@coffee.id}}" class="drawer-label"></label>
    </div>
    <div class="coffee-price">€{{@coffee.price}}</div>
    <LinkTo @route="coffee" @model={{@coffee.id}} class="view-coffee-btn">View
      Details</LinkTo>
  </div>
</article>