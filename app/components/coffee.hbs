<article class="coffee">
  <Coffee::Image src={{@coffee.image}} alt={{@coffee.name}} />
  <div class="details">
    <h3>
      <LinkTo @route="coffee" @model={{@coffee}}>
        {{@coffee.name}}
      </LinkTo>
    </h3>
    <div class="detail owner">
      <span>Name:</span>
      {{@coffee.name}}
    </div>
    <div class="detail type">
      <span>Type:</span>
      {{@coffee.type}}
    </div>
    <div class="detail location">
      <span>Description:</span>
      {{@coffee.description}}
    </div>

  </div>
</article>