<article class="coffee">
  <Coffee::Image src={{@coffee.image}} alt={{@coffee.name}} />
  <div class="coffee-details">
    <h3 class="coffee-name">
      <LinkTo @route="coffee" @model={{@coffee}}>
        {{@coffee.name}}
      </LinkTo>
    </h3>
    <div class="coffee-meta">
      <p class="coffee-owner">
        <span>Origin:</span>
        Great Coffee Co.
      </p>
      <p class="coffee-type">
        <span>Type:</span>
        {{@coffee.type}}
      </p>
      <p class="coffee-bean">
        <span>Bean:</span>
        {{@coffee.bean}}
      </p>
    </div>
    <p class="coffee-description">
      {{@coffee.description}}
    </p>
    <div class="coffee-price">€{{@coffee.price}}</div>
    <LinkTo @route="coffee" @model={{@coffee}} class="view-coffee-btn">View
      Details</LinkTo>
  </div>
</article>