{{#if this.alert.alertDisplayed}}
  <div
    class="alert alert-{{this.alert.type}}
      {{if this.alert.isClosing 'is-closing'}}"
  >
    <div class="alert-icon">
      {{this.icon}}
    </div>
    <div class="alert-message">
      {{this.message}}
    </div>
    <button type="button" class="alert-close" {{on "click" this.hideAlert}}>
      &times;
    </button>
  </div>
{{/if}}