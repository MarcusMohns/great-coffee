<article class="coffee detailed">
  <Coffee::Image src={{@coffee.image}} alt="A picture of {{@coffee.name}}" />

  <div class="details">
    <h3>{{@coffee.name}}</h3>
    <div class="detail-container">
      <div class="detail">
        By Great Coffee Co.
      </div>
      <div>
        {{repeat "★" @coffee.reviews}}
        {{repeat "☆" (emptyStars @coffee.reviews 5)}}
      </div>
    </div>

    <div class="detail type">
      <span>Type:</span>
      {{@coffee.type}}

    </div>
    <div class="detail price">
      <span>Price:</span>
      €{{@coffee.price}}
    </div>
    <div class="row-container">
      <div class="detail">
        <span>
          Ground:
        </span>
      </div>
      <select
        name="ground"
        id="ground"
        class="detail-select"
        value={{this.selectedGround}}
        {{on "change" this.handleGroundChange}}
      >
        <option value="wholeBean">Whole Bean</option>
        <option value="freshlyGround" selected>Freshly Ground</option>
      </select>
    </div>
    <div class="row-container">
      <div class="detail">
        <span>
          Quantity:
        </span>
      </div>
      <select
        name="qty"
        id="qty"
        class="detail-select"
        value={{this.qty}}
        {{on "change" this.handleQtyChange}}
      >
        <option value="1">1</option>
        <option value="2">2</option>
        <option value="3">3</option>
        <option value="4">4</option>
        <option value="5">5</option>
        <option value="6">6</option>
        <option value="7">7</option>
        <option value="8">8</option>
        <option value="9">9</option>
        <option value="10">10</option>
      </select>
    </div>

    <button
      {{on
        "click"
        (fn this.addToCart @coffee.price @coffee.name @coffee.image)
      }}
      {{on "click" this.showAlert}}
      class="addToCartBtn"
    >

      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        fill="white"
        class="add-to-shopping-cart-icon"
        viewBox="0 0 16 16"
      >
        <path
          d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .491.592l-1.5 8A.5.5 0 0 1 13 12H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5zM3.102 4l1.313 7h8.17l1.313-7H3.102zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"
        />
      </svg>

      Add to cart

    </button>

    <div class="detail description">
      {{@coffee.description}}
    </div>

  </div>
</article>