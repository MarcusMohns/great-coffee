<Jumbo>
  <h2>{{@coffee.name}}</h2>
</Jumbo>

<article class="coffee detailed">
  <Coffee::Image src={{@coffee.image}} alt="A picture of {{@coffee.name}}" />

  <div class="details">
    <h3>{{@coffee.name}}</h3>
    <div class="detail">
      By Great Coffee Co.
    </div>
    <div class="detail type">
      <span>Type:</span>
      {{@coffee.type}}

    </div>
    <div class="detail price">
      <span>Price:</span>
      €{{@coffee.price}}
    </div>
    <select name="ground" id="ground">
      <option value="wholeBean">Whole Bean</option>
      <option value="freshlyGround">Freshly Ground</option>
    </select>
    <p class="qty">
      <label for="qty">Quantity:</label>
      <button class="qtyminus qtybtn" aria-hidden="true">&minus;</button>
      <input
        type="number"
        name="qty"
        id="qty"
        min="1"
        max="10"
        step="1"
        value="1"
      />
      <button class="qtyplus qtybtn" aria-hidden="true">&plus;</button>
    </p>
    <div class="detail reviews">
      <span>reviews:</span>
      {{@coffee.reviews}}
    </div>
    <div class="detail description">
      {{@coffee.description}}
    </div>

  </div>
</article>