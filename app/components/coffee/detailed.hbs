<Jumbo>
  <h2>{{@coffee.title}}</h2>
  <p>Nice find! This looks like a nice place to stay near {{@coffee.city}}.</p>
  <a
    href="#"
    target="_blank"
    rel="external nofollow noopener noreferrer"
    class="share button"
  >
    Share on Twitter
  </a>
</Jumbo>

<article class="coffee detailed">
  <Coffee::Image src={{@coffee.image}} alt="A picture of {{@coffee.name}}" />

  <div class="details">
    <h3>About {{@coffee.name}}</h3>

    <div class="detail owner">
      <span>Owner:</span>
      {{@coffee.description}}
    </div>
    <div class="detail type">
      <span>Type:</span>
      {{@coffee.type}}
      –
      {{@coffee.description}}
    </div>
    <div class="detail location">
      <span>Location:</span>
      {{@coffee.description}}
    </div>
    <div class="detail bedrooms">
      <span>Number of bedrooms:</span>
      {{@coffee.description}}
    </div>
    <div class="detail description">
      <p>{{@coffee.description}}</p>
    </div>
  </div>

</article>