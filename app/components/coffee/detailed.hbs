<Jumbo>
  <h2>{{@coffee.name}}</h2>
</Jumbo>

<article class="coffee detailed">
  <Coffee::Image src={{@coffee.image}} alt="A picture of {{@coffee.name}}" />

  <div class="details">
    <h3>{{@coffee.name}}</h3>
    <div class="detail">
      By Great Coffee Co.
    </div>
    <div class="detail type">
      <span>Type:</span>
      {{@coffee.type}}

    </div>
    <div class="detail price">
      <span>Price:</span>
      €{{@coffee.price}}
    </div>
    <select
      name="ground"
      id="ground"
      value={{this.selectedGround}}
      {{on "change" this.handleGroundChange}}
    >
      <option value="wholeBean">Whole Bean</option>
      <option value="freshlyGround" selected>Freshly Ground</option>
    </select>
    <p class="qty">
      <label for="qty">Quantity:</label>
      <div
        class="qtyminus qtybtn"
        aria-hidden="true"
        {{on "click" this.decrementQty}}
      >&minus;</div>
      <input
        type="number"
        name="qty"
        id="qty"
        min="1"
        max="10"
        step="1"
        value={{this.qty}}
        {{on "change" this.handleQtyChange}}
      />
      <div
        class="qtyplus qtybtn"
        aria-hidden="true"
        {{on "click" this.incrementQty}}
      >&plus;</div>
    </p>
    <button
      {{on
        "click"
        (fn this.addToCart @coffee.price @coffee.name @coffee.image)
      }}
    >Add to cart</button>
    <div class="detail reviews">
      <span>reviews:</span>
      {{@coffee.reviews}}
    </div>
    <div class="detail description">
      {{@coffee.description}}
    </div>

  </div>
</article>